# Dependencies are installed from package-lock.json by CI, never committed.
node_modules/

# Generated by `wrangler types`. Regenerate rather than review a 590 KB declaration file.
worker-configuration.d.ts

# Wrangler's local state; the deployed platform is the truth.
.wrangler/

# Local overrides. Never a place for secrets that must reach the container: those are Worker
# secrets on the deployed Worker, not files on a laptop.
.dev.vars