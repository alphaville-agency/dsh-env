{
  "name": "dev-tooling-dsh-shell",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-01",
  "containers": [
    {
      "class_name": "DshShell",
      "name": "dev-tooling-dsh-shell",
      "image": "./container.Dockerfile",
      "instance_type": "lite",
      "max_instances": 1,
      "ssh": {
        "enabled": true
      },
      "authorized_keys": [
        {
          "name": "dsh",
          "public_key": "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIC+FNHSJUqtrnnyea86mdZmXNZJ+c+4LXXtc9ml47eA2 dsh@alphaville.space"
        }
      ]
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "DSH",
        "class_name": "DshShell"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "DshShell"
      ]
    }
  ],
  "routes": [
    {
      "pattern": "dev-dsh.alphaville.space",
      "custom_domain": true
    }
  ]
}
