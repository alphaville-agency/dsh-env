{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "shared-tooling-dsh-shell",
  "main": "src/worker.ts",

  // 2026-05-06 and not the earlier 2025-05-06 this repository used to pin.
  //
  // The R2 binding mount the next layer needs calls `ctx.exports.ContainerProxy` inside the
  // Durable Object, and `ctx.exports` - the loopback bindings for the Worker's top-level exports -
  // does not exist on a Durable Object's context before a compatibility date late in 2025. It is
  // not a type, not a config key and not a missing export: the runtime simply does not put the
  // property there, so the SDK's own export check throws InvalidMountConfigError and the request
  // 500s. That was the 1101. Measured against the installed workerd, not read: at 2025-11-01 `ctx`
  // has [facets, container, storage, id, props]; at 2025-12-01 it has those plus `exports`.
  "compatibility_date": "2026-05-06",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },

  // One container class, and `name` is set so the container APPLICATION is a name we declare.
  //
  // Left unset, the platform derives the application name as `<worker>-<class-lowercased>`, which
  // is `shared-tooling-dsh-shell-sandbox`: an SDK class name leaking into our namespace, and a name
  // that silently changes if the class is ever renamed. README.md, "The container application
  // name", records what was observed with this field set.
  "containers": [
    {
      "name": "shared-tooling-dsh-shell-container",
      "class_name": "Sandbox",
      "image": "./container.Dockerfile",
      "instance_type": "lite",
      "max_instances": 1
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "class_name": "Sandbox",
        "name": "Sandbox"
      }
    ]
  },
  // v1, and only v1: this Worker name is new, so its Durable Object namespace is new too. There is
  // no applied migration history to preserve and therefore no tombstones - the three tags the
  // previous, dev-named Worker needed recorded its own history, not this one's.
  "migrations": [
    {
      "new_sqlite_classes": ["Sandbox"],
      "tag": "v1"
    }
  ],

  // The durable state, mounted at /mnt/state with no credentials anywhere: the SDK signs the
  // requests inside the Durable Object, which is why `ContainerProxy` is exported from the entry.
  // Layer 1 of the rebuild, and the thing the 1101 was thrown on the way to.
  "r2_buckets": [
    {
      "binding": "STATE",
      "bucket_name": "af-shared-tooling-dsh"
    }
  ],
  "routes": [
    {
      "pattern": "dsh.alphaville.space",
      "custom_domain": true
    }
  ]
}
