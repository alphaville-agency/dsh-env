{
  "name": "dsh-workspace",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-01",
  "containers": [
    {
      "class_name": "DshContainer",
      "image": "ghcr.io/alphaville-agency/dsh-workspace:latest",
      "instance_type": "standard-1",
      "max_instances": 1,
      "ssh": {
        "enabled": true
      },
      "authorized_keys": [
        {
          "name": "dsh",
          "public_key": "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIC+FNHSJUqtrnnyea86mdZmXNZJ+c+4LXXtc9ml47eA2 dsh@alphaville.space"
        }
      ],
      "name": "dsh-workspace"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "DSH",
        "class_name": "DshContainer"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "DshContainer"
      ]
    }
  ]
}
