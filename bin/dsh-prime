#!/bin/sh
# Fetch the repositories this environment works on.
#
#   dsh-prime            clone what is missing, fetch what is there
#   dsh-prime --status   report only, change nothing
#
# WHY THIS IS A COMMAND AND NOT PART OF SESSION STARTUP. The container's disk is ephemeral: it resets
# when the container sleeps, which happens five minutes after the last request. So a clone cannot be
# baked in at build time and cannot be assumed to survive - it has to be re-established per session,
# and doing that behind the TUI would put a network clone on the path to a prompt.
#
# So the rule is the honest one: **git is the source of truth.** Clone here, work, commit, push.
# `~/.dsh/rules/where-work-happens.md` is the long form.
#
# You do not have to remember to save before you stop. The platform announces a shutdown -
# onActivityExpired() when the sleep timer fires, onStop() when the container exits - and the Worker
# uses both to copy uncommitted changes and untracked files out to R2 before the disk is discarded.
# That is a safety net for what was not pushed, not a substitute for pushing: the capture is a patch
# in an object store, and pushed work is work.
#
# Authentication is GH_TOKEN, injected at run time as a Worker secret. Nothing here reads a
# credential from disk, and nothing prints one.
set -eu

# REFRESH THE AGENT CONFIGURATION FIRST, so the rules the session reads are the repository's current
# ones rather than whatever the image was built with. Reported and non-fatal: stale rules beat no rules.
if command -v dsh-config-pull >/dev/null 2>&1; then
    dsh-config-pull --quiet || echo "  [the configuration could not be refreshed; using the image's copy]" >&2
fi

WORKSPACE="${DSH_WORKSPACE:-/workspace}"
ORG="${DSH_ORG:-alphaville-agency}"
STATUS_ONLY=0

# The repositories worth having. `capability` is the one that matters for clean-slate work - it holds
# the naming registry, the goals, the decisions and the rules the agency inherits.
REPOS="agency tooling reference-implementation"

[ "${1:-}" = "--status" ] && STATUS_ONLY=1

say() { echo "$*" >&2; }

if ! command -v gh >/dev/null 2>&1; then
    say "gh is not installed, so the repositories cannot be fetched."
    exit 1
fi

if [ -z "${GH_TOKEN:-}" ] && [ -z "${GITHUB_TOKEN:-}" ]; then
    say "GH_TOKEN is not set. The environment could not clone or push without it."
    say "It is a Worker secret; if it is missing, whoever provisioned this environment has not set it."
    exit 1
fi

if ! gh auth status >/dev/null 2>&1; then
    say "gh is not authenticated. GH_TOKEN is present but rejected - it may be expired or revoked."
    exit 1
fi

mkdir -p "$WORKSPACE"
cd "$WORKSPACE"

# The repositories are fetched IN PARALLEL, because they are independent and cloning them one after
# another puts the sum of their latencies on the path to the TUI. Three shallow clones of small
# repositories are seconds in parallel and tens of seconds in series, and a session that takes a
# minute to open reads as broken.
#
# Each child writes its own report; the parent waits and then reprints them, so the output stays in a
# stable order rather than interleaving.
results_dir=$(mktemp -d)
trap 'rm -rf "$results_dir"' EXIT

for repo in $REPOS; do
    (
        dir="$WORKSPACE/$repo"
        if [ -d "$dir/.git" ]; then
            if [ "$STATUS_ONLY" -eq 1 ]; then
                echo "present: $repo"
            elif git -C "$dir" fetch --quiet --depth 1 origin 2>/dev/null; then
                echo "refreshed: $repo"
            else
                echo "present (could not reach origin): $repo"
            fi
        elif [ "$STATUS_ONLY" -eq 1 ]; then
            echo "MISSING: $repo"
        elif gh repo clone "$ORG/$repo" "$dir" -- --quiet --depth 1 2>/dev/null; then
            echo "cloned: $repo"
        else
            echo "could not clone: $ORG/$repo"
        fi
    ) > "$results_dir/$repo" 2>&1 &
done

# Wait for every child, and do not let one failure abort the others.
wait || true

# THE COMMIT IDENTITY BELONGS TO THE REPOSITORY, NOT TO THE CONTAINER.
#
# The image sets one global identity (`alphaville@alphaville.space`) because a git with no identity
# refuses to commit at all. But this workspace clones two different projects, and the container's own
# rules distinguish them: tooling is the dev environment and is committed as `dev@alphaville.space`,
# while the agency is committed as `alphaville@alphaville.space`. One global default would attribute
# every commit from both to one address - and attributing a project's work to the wrong identity is
# the same class of mistake the entity's own rules call out: signing up AS the entity is authorised,
# acting as somebody else is not.
#
# Local config wins over global, so this only changes what each repo already had. A repo that is not
# listed keeps the container's global default, which is the correct fallback rather than a guess.
for repo in $REPOS; do
    [ -d "$WORKSPACE/$repo/.git" ] || continue
    case "$repo" in
        tooling)  email=dev@alphaville.space ;;
        agency)   email=alphaville@alphaville.space ;;
        *)        continue ;;
    esac
    git -C "$WORKSPACE/$repo" config user.name  "Alphaville"       && git -C "$WORKSPACE/$repo" config user.email "$email"
done

for repo in $REPOS; do
    [ -f "$results_dir/$repo" ] && cat "$results_dir/$repo"
done

if [ "$STATUS_ONLY" -eq 0 ]; then
    say ""
    say "The workspace is ephemeral: /workspace resets when the container sleeps."
    say "Uncommitted work is copied to R2 automatically when the container stops, but pushing is"
    say "still how work leaves this environment. The capture is a safety net, not a workflow."
fi
cd "$WORKSPACE"