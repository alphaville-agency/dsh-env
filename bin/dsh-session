#!/bin/sh
# What a session actually runs: prime the workspace, then the harness, on the dsh-tui profile.
#
# WHY THIS EXISTS RATHER THAN A COMMAND WITH ARGUMENTS. The terminal route passes the program to run
# as a single name from an allowlist (see TERMINAL_SHELL_ALLOWED in src/names.ts), because that value
# reaches the container as the process to execute and a value that can carry arguments is a command,
# not a program. The alternative was to open a shell and type a command into it, which is wrong for a
# session that survives a disconnect: the SDK keeps the PTY alive and replays its output on reconnect,
# so an injected line would be typed into an already-running TUI.
#
# IT ATTACHES TO THE CONVERSATION THAT IS ALREADY THERE. Opening a blank one every time is the defect
# this file exists to end: the operator's work is in the conversation, and a launcher that starts
# fresh makes every reconnect look like the environment forgot. `--resume` is the harness's own flag
# and takes the session id, so nothing here re-implements resuming - it only answers "which one",
# from the store on disk rather than from a marker file, because the marker is written on a clean
# exit and a container that sleeps is not a clean exit.
#
# AND A REFUSED RESUME MUST NOT COST THE OPERATOR A SESSION. A launch-time `--resume` is an explicit
# request: the harness fails the boot loudly rather than silently substituting a fresh conversation
# (`resolveAgent`, dsh-adapter/plugin.js). That is right for a person typing the flag and wrong for a
# launcher that chose the id itself, so the launcher retries without it and says what happened.
#
# AND THE STORE IT ATTACHES TO IS BACKED BY R2. The container's disk is discarded when it sleeps, so
# a conversation written to `/root/.dsh/sessions` and nothing else is gone at the next wake, and the
# attach logic above finds an empty store and starts fresh. The Worker mounts the state bucket at
# `/mnt/state` before this script runs, and this script symlinks the store into it. The mount and the
# symlink are explained where they are made, further down.
#
# PRIMING HAPPENS HERE, BEFORE THE TUI, and that is the correction that makes a session "primed"
# rather than "primed if you remember". The container's disk resets when it sleeps, so the
# repositories have to be re-established per session - and a session that opens into an empty
# /workspace with no repositories is not ready to work, it is ready to fetch them. Putting the fetch
# behind the TUI would mean the first thing every session does is a manual command, which is exactly
# the kind of step that gets forgotten.
#
# It is bounded and it fails soft. `dsh-prime` fetches each repository at depth 1; on a warm
# container with the clones present it is a handful of git fetches, and on a fresh one it is three
# clones. If it fails - no network, no token - the TUI still opens and says so, because a session
# that refuses to start because GitHub was unreachable is worse than a session without clones.
#
# The profile is `dsh-tui`, matching the committed dsh-profile/ manifest.
#
# NOT `exec` ANY MORE. The resume has a fallback, and a fallback needs a process that outlives the
# first attempt; the TUI still owns the terminal, because this shell waits on it and does nothing
# else. The cost is one `sh` between the PTY and the TUI, which is the price of the retry.
set -eu

PROFILE="${DSH_PROFILE:-dsh-tui}"
DSH_HOME_DIR="${DSH_HOME:-/root/.dsh}"
STORE="$DSH_HOME_DIR/sessions"
HARNESS_ERR=/tmp/dsh-harness.err

show_harness_stderr() {
    [ -s "$HARNESS_ERR" ] || return 0
    echo "[what the harness wrote to stderr]"
    sed 's/^/  /' "$HARNESS_ERR" 2>/dev/null || true
}

# Run the harness and record what it exited with, without `set -e` ending the script at the failure -
# there is a report to print afterwards, and it is about that failure.
run_harness() {
    STATUS=0
    dsh --profile "$PROFILE" "$@" 2>"$HARNESS_ERR" || STATUS=$?
}

if ! command -v dsh >/dev/null 2>&1; then
    echo "dsh is not on PATH. The harness launcher is missing from this image." >&2
    exec sh
fi

if [ ! -d "$DSH_HOME_DIR/profiles/$PROFILE" ]; then
    echo "the '$PROFILE' profile is not installed in $DSH_HOME_DIR/profiles." >&2
    echo "expected the committed dsh-profile/ tree to have been materialised at build time." >&2
    exec sh
fi

# Which container this is. The boot id identifies the INSTANCE rather than the name, so it is the one
# honest witness that the platform stopped this container and started another - the whole question a
# persistence test asks, and a value the operator cannot otherwise see from inside a session.
echo "[boot $(cat /proc/sys/kernel/random/boot_id 2>/dev/null || echo unknown) at $(date -u +%Y-%m-%dT%H:%M:%SZ)]"

# What this session will run. Printed because a TUI that opens onto nothing is otherwise
# indistinguishable from a TUI that never started, and the versions are the first thing to look at
# when it does: the profile is installed at image build time by `dsh plugin add`, so a rebuild can
# change it.
TUIPKG="$DSH_HOME_DIR/profiles/$PROFILE/node_modules/@deepseek-harness-tui/dsh-tui/package.json"
if [ -f "$TUIPKG" ]; then
    echo "[harness $(dsh --version 2>/dev/null | head -1) · dsh-tui $(sed -n 's/^ *"version": *"\([^"]*\)".*/\1/p' "$TUIPKG" | head -1)]"
else
    echo "[harness $(dsh --version 2>/dev/null | head -1) · the dsh-tui package is not in the profile]"
fi

# THE SESSION STORE IS A PLAIN DIRECTORY ON CONTAINER DISK, AND THAT IS A DELIBERATE CHOICE.
#
# It was previously symlinked into an R2 mount so conversations would outlive a sleep. The mount
# worked; the store did not, and not because of a config error. The harness commits a session by
# staging to a temp file and then `link()`ing it into place:
#
#     await internals.fs.link(staged, currentPath)
#
# `link(2)` creates a HARD LINK. FUSE filesystems do not support it - which is why the operator saw
# `ENOTSUP: operation not supported on socket, link .../session.v3.jsonl.zstd.<tok>.tmp ->
# .../session.v3.jsonl.zstd`. The bytes were written to the backing store; the commit step that
# makes them the file `/resume` reads cannot run. So sessions were never really persisting, and the
# error was reported rather than ignored, exactly as the harness intends.
#
# WHY NOT KEEP THE SYMLINK. The harness would have to commit with a rename instead of a hard link,
# which it cannot, or we would have to run a different persistence backend. Neither is ours to
# change. So the store is a normal directory - and because a conversation must survive a SLEEP, the
# bytes are COPIED to the R2 mount on the way out of the session (see the exit path at the bottom of
# this file) and RESTORED from it on the way in. A copy is a plain write, which FUSE handles; only
# link(2) is unsupported.
#
# The R2 mount itself is left alone: `src/worker.ts` still mounts it at $DSH_STATE_MOUNT for
# anything else that wants durable state. Nothing links the store into it any more, so a mount
# failure can no longer look like a working store - which is the failure mode this comment exists
# to stop someone reintroducing.
is_mount_point() {
    if command -v mountpoint >/dev/null 2>&1; then
        mountpoint -q "$1"
    else
        # No `mountpoint` (macOS, where this is tested): compare the device of the path with its
        # parent's, and only a mounted filesystem has its own. `dirname` on `/` yields `/`, which is
        # handled by refusing to call the root of the filesystem a mount of itself.
        parent=$(dirname "$1")
        [ "$parent" != "$1" ] || return 1
        [ "$(df -P "$1" 2>/dev/null | awk 'NR==2 {print $1}')" != \
          "$(df -P "$parent" 2>/dev/null | awk 'NR==2 {print $1}')" ]
    fi
}

STATE_MOUNT="${DSH_STATE_MOUNT:-/mnt/state}"
if [ -L "$STORE" ]; then
    # Upgrading from an earlier build that already linked it. A symlink to an R2-backed path is
    # exactly the incompatible arrangement above; replace it with the real directory it was meant
    # to be, and leave the bytes where they are rather than moving them behind a working harness.
    rm -f "$STORE"
fi
mkdir -p "$STORE" 2>/dev/null || true
echo "[session store: local directory at $STORE (survives TUI restarts, not a sleep)]"
echo "[the R2 mount at $STATE_MOUNT is not used for sessions: FUSE has no link(2), and the harness]"
echo "[commits sessions with a hard link, which is why they never persisted behind it.]"
# RESTORE FROM R2 BEFORE ANYTHING ASKS WHAT EXISTS. The store is on ephemeral disk, so after a sleep
# it is empty and the session looks like a first boot. The bytes were copied to the mount on the way
# out of the previous session; this brings them back before `session_logs` reads them, so a reconnect
# attaches to the conversation that was actually last there.
#
# `is_mount_point` is the same ground truth as before: a directory that merely exists is not a
# backing, and linking/copying from an empty local directory would quietly report success. A failed
# restore is a report, never a gate - a session whose history did not come back is still a session.
if is_mount_point "$STATE_MOUNT" && [ -d "$STATE_MOUNT/$(basename "$STORE")" ]; then
    STATE_STORE="$STATE_MOUNT/$(basename "$STORE")"
    restored=$(cp -a "$STATE_STORE/." "$STORE/" 2>&1 || true)
    if [ -n "$restored" ]; then
        echo "[restore from R2 reported a problem: $restored]"
    else
        echo "[restored conversations from R2 into $STORE]"
    fi
fi

# Every conversation the harness has stored, newest first. The store is one directory per project
# and one per session beneath it; the harness names the session directory after the session id and
# writes `session.v3.jsonl.zstd` inside it (`dsh-session-persistence-jsonl`, and `root:
# dshHomePath('sessions')` in the profile's own patch layer).
#
# `ls -1dt` rather than `find -printf '%T@'`: both sort by mtime, and only one of them also exists on
# the machine this is tested on.
session_logs() {
    find -L "$STORE" -name 'session*.jsonl*' -type f 2>/dev/null || true
}

newest_session_id() {
    logs=$(session_logs)
    [ -n "$logs" ] || return 0
    newest=$(printf '%s\n' "$logs" | tr '\n' '\0' | xargs -0 ls -1dt 2>/dev/null | head -1)
    [ -n "$newest" ] || return 0
    basename "$(dirname "$newest")"
}

echo "[conversations in $STORE]"
logs=$(session_logs)
count=$(printf '%s' "$logs" | grep -c . || true)
if [ "$count" -eq 0 ]; then
    echo "  none stored yet: this is the first conversation in this container."
else
    echo "  $count stored, newest first:"
    printf '%s\n' "$logs" | tr '\n' '\0' | xargs -0 ls -1dt 2>/dev/null | head -3 | while IFS= read -r log; do
        size=$(wc -c < "$log" 2>/dev/null | tr -d ' ')
        echo "    $(basename "$(dirname "$log")")  ${size:-0} bytes  ($log)"
    done
fi

# Prime the workspace. Deliberately not silent: a session that spent thirty seconds fetching should
# say what it was doing, and one that could not fetch should say that instead.
if command -v dsh-prime >/dev/null 2>&1; then
    echo "[priming the workspace: fetching the repositories it works on]"
    if ! dsh-prime 2>&1 | sed 's/^/  /'; then
        echo "  [priming did not finish. The session still works; run dsh-prime again inside it.]"
    fi
    echo "[workspace ready: $(ls -1 /workspace 2>/dev/null | wc -l | tr -d ' ') entries in /workspace]"
else
    echo "[dsh-prime is not on PATH, so the workspace was not fetched]" >&2
fi

# Say where the work stands, from the repository rather than from a list kept here.
#
# This is deliberately derived: the build order lives in the agency repo's docs/HANDOVER.md, and a
# status line maintained in this script would be a second place for it to drift. If the clone is not
# there, say that instead of inventing a state.
if [ -f /workspace/agency/docs/HANDOVER.md ]; then
    echo "[clean-slate build]"
    echo "  the goal, the decisions and the build order are in /workspace/agency/docs/:"
    echo "    GOALS.md  DECISIONS.md  HANDOVER.md  ONTOLOGY.md  rules/"
    # Show the numbered rungs so the next step is visible without opening anything.
    sed -n '/^## Build order/,/^## /p' /workspace/agency/docs/HANDOVER.md 2>/dev/null \
        | grep -E '^[0-9]+\.' \
        | sed 's/^/    /' \
        | head -6
    echo "  Most recent commit on the capability repo:"
    git -C /workspace/agency log -1 --format='    %h %s' 2>/dev/null || true
else
    echo "[the capability repository is not in /workspace, so the build state cannot be shown]"
fi
echo
# THE BRIEF IS ONE THING, BUILT BEFORE EITHER BRANCH, SO BOTH CAN SEND IT.
#
# It was built inside the fresh branch only, which made it dead code the moment a conversation
# existed: an existing session takes the RESUME branch, so a container that had ever run one
# attached to an unbriefed history and never saw GOALS.md. The goals were on disk, printed by the
# banner, and never in front of the model - the exact failure GOALS.md exists to prevent.
#
# Fresh: it is the first message. Resumed: it is sent as a follow-up after the TUI attaches,
# because that conversation is already open and a positional prompt would arrive too late.
#
# It fails soft, the way dsh-prime handles a missing clone: no capability repo or unreadable
# goals leave BRIEF empty and both paths still start, with a line saying why.
BRIEF=""
# BUILT IN SHELL, NOT PYTHON. python3 is deliberately absent from this image - it is listed among
# the tools parked in container.Dockerfile ("each comes back with the layer that can be verified to
# use it"), so the python heredoc that built this brief failed, `|| true` swallowed the failure, and
# BRIEF was silently empty in the container while looking correct on the laptop where python3 exists.
# The goal files are plain text; shell can read them.
if [ -f /workspace/agency/docs/GOALS.md ]; then
    GOALS_BODY=$(cat /workspace/agency/docs/GOALS.md 2>/dev/null || true)
    HANDOVER_BODY=""
    if [ -f /workspace/agency/docs/HANDOVER.md ]; then
        HANDOVER_BODY=$(cat /workspace/agency/docs/HANDOVER.md 2>/dev/null || true)
    fi
    BRIEF=$(cat <<BRIEF_EOF
You are working autonomously on the agency in /workspace. Below are the standing goal and the
handover - the standard the work is judged by, not a specification for it.

=== GOALS.md ===
$GOALS_BODY

=== HANDOVER.md ===
$HANDOVER_BODY

Start at build order step 1 (Console and authoritative ledger). Choose the ordering yourself,
keep going across turns, and report what you decided rather than asking. If you are blocked on
a credential, an account or an endpoint, name it and continue on the unblocked work - AGENTS.md
says where to request what you cannot mint.
BRIEF_EOF
)
    # A brief that came back empty or absurdly short is not a brief: the heredoc above would have
    # expanded to the header with empty bodies if the reads failed, so check the size.
    if [ ${#BRIEF} -lt 500 ]; then
        echo "[brief too short (${#BRIEF} chars): the goals did not read correctly]"
        BRIEF=""
    fi
fi
if [ -n "$BRIEF" ]; then
    echo "[brief from /workspace/agency/docs: GOALS.md + HANDOVER.md is ready for this session]"
else
    echo "[no brief: the capability repository is not in /workspace, or its goals are unreadable]"
fi

RESUME_ID=$(newest_session_id || true)
# The id is a directory name in the store, and it is about to become an argument. Anything that is
# not a plain name is not a session id this launcher found, and is not passed on.
case "$RESUME_ID" in
    *[!A-Za-z0-9._-]*) RESUME_ID="" ;;
esac

if [ -n "$RESUME_ID" ]; then
    echo "[attaching to #$RESUME_ID, the most recent conversation in this container]"
    # THE BRIEF, ON THE RESUME PATH.
    #
    # A positional argument cannot be used here: by the time the TUI attaches, the argument would be
    # swallowed, so the brief has to arrive as an ordinary message typed into the open conversation.
    # It is sent AFTER the harness exits rather than before it, because the PTY is read by the TUI
    # itself - a sender racing the attach window loses to it, and a message written before the TUI
    # draws becomes garbage in a redraw. Sending on exit costs one process nothing, and guarantees
    # the text reached the PTY while the session was still alive.
    #
    # `sleep` is deliberate and bounded: the TUI needs time to draw and connect before input is
    # meaningful, and this only ever runs on a resume, where the conversation is already open.
    if [ -n "$BRIEF" ]; then
        echo "[sending the brief to the open conversation]"
        (
            sleep 8
            printf '%s\r' "$BRIEF"
        ) &
        BRIEF_PID=$!
    fi
    # `if`, not `&&`: with `set -e` a failing command in a condition is a result, not the end of the
    # script. A clean exit from the TUI is the operator finishing, and that is not a retry either.
    if dsh --profile "$PROFILE" --resume "$RESUME_ID" "$@" 2>"$HARNESS_ERR"; then
        STATUS=0
    else
        STATUS=$?
        echo
        echo "[the harness exited without staying in #$RESUME_ID, so the session above is why. Rather]"
        echo "[than leave you with no session at all, here is a fresh one. #$RESUME_ID is untouched and]"
        echo "[can still be picked from /resume inside it.]"
        show_harness_stderr
        echo
        run_harness "$@"
    fi
else
    echo "[no stored conversation to attach to: starting a new one, briefed from /workspace/agency/docs]"
    # THE BRIEF IS THE FIRST MESSAGE. Built above, so it is the same text the resume path sends -
    # one brief, two arrival routes, rather than a second copy that can drift from the first.
    if [ -n "$BRIEF" ]; then
        run_harness "$BRIEF" "$@"
    else
        echo "  [unbriefed: there was no brief to send]"
        run_harness "$@"
    fi
fi

# The harness's exit status and its stderr, printed rather than discarded. A TUI that exits without
# drawing anything is a blank terminal and no explanation; this is the explanation, and it is the
# only place it exists. The cost of redirecting stderr to a file is that it is not live during the
# session, which for a TUI whose render target is stdout is a price worth paying once.
echo
echo "[the harness exited with status $STATUS]"
show_harness_stderr

# The follow-up sender on the resume path, if one was started. Left running it would die with the
# shell anyway, but waiting for it is not owed: the message is either already in the PTY or gone.
[ -n "${BRIEF_PID:-}" ] && kill "$BRIEF_PID" 2>/dev/null || true

# COPY THE SESSION OUT TO R2 ON THE WAY OUT. The store is a normal directory because the harness
# commits it with `link(2)`, which the R2 mount does not support; this is how it still survives a
# sleep. The copy happens HERE, after the harness has exited and written its file, because there is
# no reliable "the container is stopping" moment this script can hook - the harness's own exit is the
# one event that is certain to have happened, and it is the one that just produced the bytes.
#
# Plain `cp`, never `link` or `mv`: a copy is an ordinary write, and FUSE writes fine. It is allowed
# to fail without failing the session, because a session that could not reach R2 is still a session -
# it only means the next boot restores nothing.
if is_mount_point "$STATE_MOUNT"; then
    STATE_STORE="$STATE_MOUNT/$(basename "$STORE")"
    mkdir -p "$STATE_STORE" 2>/dev/null || true
    out=$(cp -a "$STORE/." "$STATE_STORE/" 2>&1 || true)
    if [ -n "$out" ]; then
        echo "[copying the session to R2 reported a problem: $out]"
    else
        echo "[session copied to R2: $STORE -> $STATE_STORE]"
    fi
fi

# What the session left behind, which is the question the next boot asks of this boot. It is printed
# here because this is the last moment the container still holds the answer.
LEFT=$(session_logs | grep -c . || true)
echo "[conversations in $STORE after this session: ${LEFT:-0}]"
exit "$STATUS"
