#!/bin/sh
# Wrap a login shell. The lease is renewed while the session is open and removed on exit, so the
# workspace reports idle the moment the last developer disconnects.
LEASE_NAME="${USER:-dev}-$$"
STATUS="${DSH_STATUS_URL:-http://127.0.0.1:8787}"
renew() { curl -fsS -m 5 -X POST -H "X-Lease-Name: $LEASE_NAME" "$STATUS/lease" >/dev/null 2>&1 || true; }
renew
( while :; do sleep 30; renew; done ) &
HEARTBEAT=$!
trap 'kill $HEARTBEAT 2>/dev/null; rm -f "${DSH_LEASE_DIR:-/run/dsh-leases}/$LEASE_NAME"' EXIT INT TERM
exec "${SHELL:-/bin/sh}" -l
